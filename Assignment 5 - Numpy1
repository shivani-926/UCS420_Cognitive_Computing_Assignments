def find_most_frequent(array, array_name):
    values, counts = np.unique(array, return_counts=True)
    max_count = counts.max()
    most_frequent_values = values[counts == max_count]
    print(f"Array {array_name}: {array}")
    for val in most_frequent_values:
        # np.where finds the exact index positions of the target value
        indices = np.where(array == val)[0]
        print(f" -> Most frequent value: {val} | Indice(s): {indices}")

# i. Array x
