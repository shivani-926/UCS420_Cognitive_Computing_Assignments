#QUESTION 2
import numpy as np
steps = np.array([
    [5000, 6200, 7100],
    [8000, 7500, 9000],
    [4500, 5100, 4800],
    [9000, 8500, 9500]
])
# a. Total steps
total_steps = np.sum(steps)
print("Total steps:", total_steps)
# b. Mean steps
mean_steps = np.mean(steps)
print("Mean steps:", mean_steps)
# c. Maximum and minimum
maximum = np.max(steps)
minimum = np.min(steps)
print("Maximum steps:", maximum)
print("Minimum steps:", minimum)
# d. Total steps for each day
daily_total = np.sum(steps, axis=0)
print("Total steps for each day:", daily_total)
# e. Total steps for each user
user_total = np.sum(steps, axis=1)
print("Total steps for each user:", user_total)
# f. Position of maximum value
max_index = np.argmax(steps)
position = np.unravel_index(max_index, steps.shape)
print("Flattened index of maximum:", max_index)
print("User/day position:", position)

#QUESTION 3
import numpy as np
# a. Create the original NumPy array
original = np.array([1, 2, 3, 4, 5, 6])
# b. Create a slice from index 1 to 4
subset = original[1:5]
# c. Modify the first element of subset
subset[0] = 999
print("Original after modifying subset:", original)
print("Subset:", subset)
# d. Create another slice using copy()
copied = original[1:5].copy()
# Modify the first element of copied
copied[0] = 500
print("Original after modifying copied:", original)
print("Copied array:", copied)
# e. Create numbers 1 to 12 and reshape into 3 x 4
matrix = np.arange(1, 13).reshape(3, 4)
print("3 x 4 matrix:")
print(matrix)
# f. Indexing and slicing
# First row
first_row = matrix[0, :]
# Last row
last_row = matrix[-1, :]
# Second column
second_column = matrix[:, 1]
# Rows 1-2 and columns 2-3
selected = matrix[1:3, 2:4]
print("First row:", first_row)
print("Last row:", last_row)
print("Second column:", second_column)
print("Rows 1-2 and columns 2-3:")
print(selected)
# g. Flatten using flatten() and ravel()
flattened = matrix.flatten()
raveled = matrix.ravel()
print("Flattened array:", flattened)
print("Raveled array:", raveled)
# h. Modify ravel() result
raveled[0] = 1000
print("After modifying ravel():")
print("Raveled array:", raveled)
print("Original matrix:")
print(matrix)
# i. Modify flatten() result
flattened[1] = 2000
print("After modifying flatten():")
print("Flattened array:", flattened)
print("Original matrix:")
print(matrix)
# j. Display shape, ndim, size, dtype
print("Shape:", matrix.shape)
print("Number of dimensions:", matrix.ndim)
print("Size:", matrix.size)
print("Data type:", matrix.dtype)

#QUESTION 4
import numpy as np
y = np.array([40, 65, 30, 85])
X = np.array([
    [6, 70, 3],
    [5, 50, 6],
    [8, 80, 2],
    [4, 30, 8]
])
# a
shape = X.shape
ndim = X.ndim
# b
X_T = X.T
# c
XT_X = X.T @ X
# d
XT_X_inv = np.linalg.inv(XT_X)
# e
beta = XT_X_inv @ X.T @ y
# g
new_user = np.array([5, 40, 7])
prediction = new_user @ beta
print("a: shape=", shape, "ndim=", ndim)
print("b: X.T=\n", X_T)
print("c: XT_X=\n", XT_X)
print("d: XT_X_inv=\n", XT_X_inv)
print("e: beta=\n", beta)
print("g: prediction=", prediction)
