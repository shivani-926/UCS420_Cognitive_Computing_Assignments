def categorize_performance(rating):
    if rating >= 4.5:
        return 'Excellent'
    elif 4.0 <= rating < 4.5:
        return 'Good'
    else:
        return 'Average'

df_6['Performance_Category'] = df_6['Rating'].apply(categorize_performance)
